# ==============================================================================
# CONFIGURACIÓN DE ORACLE DATABASE — TOOLBOX PRO
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo en la raíz del proyecto con el nombre exacto: .env
# 2. Completa los valores con tus credenciales corporativas de Oracle.
# 3. NUNCA subas el archivo .env al repositorio Git.
# ==============================================================================

ORACLE_USER=mi_usuario
ORACLE_PASSWORD=cambiar_esto
ORACLE_HOST=servidor-oracle.empresa.local
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCLPDB1

# Opcional: Si defines ORACLE_DSN, tendrá prioridad sobre HOST, PORT y SERVICE_NAME
# Ejemplo: ORACLE_DSN=servidor-oracle.empresa.local:1521/ORCLPDB1
ORACLE_DSN=


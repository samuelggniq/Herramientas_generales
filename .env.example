# ==============================================================================
# Configuración de Conexión a Base de Datos Oracle
# ==============================================================================

# Credenciales de usuario Oracle
ORACLE_USER=
ORACLE_PASSWORD=

# Opción 1: DSN completo
ORACLE_DSN=

# Opción 2: Parámetros individuales (se usan si ORACLE_DSN está vacío)
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE_NAME=

# Nombre de la tabla o vista a consultar/extraer (e.g. ESQUEMA.TABLA)
ORACLE_TABLE=

# Tamaño del lote (filas) para la extracción en memoria (por defecto: 50000)
ORACLE_CHUNK_SIZE=50000
